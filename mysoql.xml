<?xml version="1.0" encoding="UTF-8"?>
<!--
  File:        mysoql.xml
  Date:        01/17/2021
  Description: MySOQL - A SOQL query tool implemented in Java/REST/Swing.
-->
<query>
    <globalProps>
        <fetchLimit>1000</fetchLimit>               <!-- fetch data in chunks of n rows (default 0 all rows)      -->
        <sampling>2000</sampling>                   <!-- sampling size (default 0 all rows)                       -->
        <refresh>0</refresh>                        <!-- refresh query every 0..60 seconds (default 0 no refresh) -->
        <translationLength>4096</translationLength> <!-- Translation limit of 4K characters (default 0 no limit)  -->
        <translationProvider>libretranslate</translationProvider> <!-- libretranslate (default) or google -->
        <translationUrl>http://localhost:5000/translate</translationUrl> <!-- translation endpoint -->
        <!-- To use Google Cloud Translation instead:
        <translationProvider>google</translationProvider>
        <translationUrl>https://translation.googleapis.com/language/translate/v2</translationUrl>
        -->
        <lcsd>tika</lcsd>                           <!-- lcsd oracle or tika (default tika)                       -->
        <browserPath>/opt/google/chrome/chrome</browserPath>
        <hostUrl>https://localhost:6101</hostUrl>
        <apiVersion>v69.0</apiVersion>
        <userId></userId>
        <password></password>
        <clientId></clientId>
        <clientSecret></clientSecret>
        <clientHeader>SfdcInternalQA/...</clientHeader>
        <connectTimeout>45</connectTimeout>         <!-- HTTP connection timeout in seconds                       -->
        <reveal>false</reveal>                      <!-- reveal clientId/clientSecret/accessToken on console       -->
    </globalProps>
</query>
